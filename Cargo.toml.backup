[workspace]
members = [
    "packages/rust-wasm-binding",
    "packages/yew",
    "packages/yew-macro",
]
exclude = ["examples/.cargo"]
default-members = [
    "packages/yew",
]
resolver = "3"

[profile.release]
lto = true
codegen-units = 1
panic = "abort"
opt-level = "z"

[profile.bench]
lto = true
codegen-units = 1
opt-level = 3

[workspace.lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = [
    "cfg(documenting)",
    "cfg(verbose_tests)",
    "cfg(yew_lints)",
    "cfg(nightly_yew)",
]}
[workspace.dependencies]
tokio = { version = "1.50.0" }
implicit-clone = { version = "0.6.0" }
proc-macro2 = "1"
quote = "1"
syn = { version = "2" }
trybuild = "1"
clap = { version = "4", features = ["derive"] }
serde = "1"
serde_json = "1"
futures = { version = "0.3", default-features = false }
log = "0.4"
tracing-subscriber = { version = "0.3", features = ["fmt"] }
rand = "0.9"
getrandom = "0.3"
rustversion = "1"
strum = "0.28"
strum_macros = "0.28"
anyhow = "1"
chrono = "0.4"
thiserror = "2.0"
bincode = { version = "2.0.0-rc.3", features = ["serde"] }
reqwest = "0.13"
